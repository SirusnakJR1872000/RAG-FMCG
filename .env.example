# ── Site ──────────────────────────────────────────────
SITE_ORIGIN=https://localhost
APP_ENV=development                     # development | production

# ── Security ──────────────────────────────────────────
JWT_SECRET_KEY=change-me-run-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_IDLE_MINUTES=30
REFRESH_ABSOLUTE_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=30
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_EXPIRY_DAYS=90
RATE_LIMIT_QUERY=10/minute
RATE_LIMIT_LOGIN=5/minute

# ── LLM ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434   # http://ollama:11434 in Docker
LLM_MODEL=llama3.1:8b
QUESTION_GEN_MODEL=llama3.2:3b           # offline only
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.1
LLM_MAX_TOKENS_ANSWER=400
LLM_MAX_TOKENS_REWRITE=64
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=180
LLM_QUEUE_MAX=10

# ── Retrieval ─────────────────────────────────────────
EMBEDDING_MODEL=intfloat/e5-small-v2     # set from reports/model_benchmark.md (D-11)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # set from benchmark
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP_TOKENS=48
CANDIDATES_PER_RETRIEVER=20
RRF_K=60
CONTEXT_CHUNKS=4
RELEVANCE_THRESHOLD=0.0                  # set from reports/threshold.md
QUERY_EXPANSION=false                    # gated by D-14
HISTORY_TURNS=2

# ── Limits ────────────────────────────────────────────
QUESTION_MIN_CHARS=3
QUESTION_MAX_CHARS=1000

# ── Paths ─────────────────────────────────────────────
CORPUS_DIR=corpus
DATA_DIR=data
INDEX_DIR=indexes
MODEL_DIR=models
REPORTS_DIR=reports
SQLITE_PATH=data/app.db
BACKUP_DIR=backups

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
